                      <ComboBoxItem Content="Fusion 360 · 相机直连" Tag="FusionNative"/>
                      <ComboBoxItem Content="FreeCAD（试用适配）" Tag="FreeCAD"/>
                      <ComboBoxItem Content="Rhino 8（试用适配）" Tag="Rhino"/>
                      <ComboBoxItem Content="全局适配 · 自动识别软件" Tag="Global"/>
                      <ComboBoxItem Content="SOLIDWORKS · 六轴直连" Tag="SolidWorks"/>
                  </ComboBox>
                  <Button Grid.Column="2" x:Name="NavigationExportButton" Content="导出适配器 ZIP" Height="34" Padding="10,0" Margin="8,0,0,0"/>
                  <Button Grid.Column="3" x:Name="NavigationToggleButton" Content="开启导航" Height="34" MinWidth="86" Margin="8,0,0,0"
                          Background="#E0F4F0" BorderBrush="#81C2B9" Foreground="#153A37"/>
                </Grid>
              </Border>
              <Border Background="{DynamicResource PanelTintBrush}" CornerRadius="8" Padding="12,7" Margin="0,0,0,10">
                <TextBlock x:Name="NavigationStatusText" FontSize="12" FontWeight="SemiBold" Foreground="#24424B" TextWrapping="Wrap"/>
              </Border>
              <Border Style="{StaticResource PanelStyle}" Padding="14,11" Margin="0,0,0,10">
                <StackPanel>
                  <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="导航手感" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Grid.Column="1" x:Name="NavigationValuesText" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center"/>
                  </Grid>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="平移与缩放" FontSize="12"/><Slider x:Name="NavigationLinear" Minimum="0.01" Maximum="3" Value="0.35" TickFrequency="0.01" SmallChange="0.01" LargeChange="0.05" IsSnapToTickEnabled="True" AutomationProperties.Name="平移与缩放速度"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="旋转" FontSize="12"/><Slider x:Name="NavigationAngular" Minimum="0.01" Maximum="3" Value="0.35" TickFrequency="0.01" SmallChange="0.01" LargeChange="0.05" IsSnapToTickEnabled="True" AutomationProperties.Name="旋转速度"/></StackPanel>
                    <StackPanel Grid.Column="4"><TextBlock Text="回中死区" FontSize="12"/><Slider x:Name="NavigationDeadZone" Minimum="0" Maximum="100" Value="16" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="回中死区"/></StackPanel>
                  </Grid>
                  <Separator Background="{DynamicResource LineBrush}" Margin="0,5,0,7" Height="1"/>
                  <StackPanel Orientation="Horizontal"><TextBlock Text="反转轴" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <CheckBox x:Name="NavInvertX" Content="X" Margin="0,0,14,0"/><CheckBox x:Name="NavInvertY" Content="Y" Margin="0,0,14,0"/><CheckBox x:Name="NavInvertZ" Content="Z" Margin="0,0,14,0"/><CheckBox x:Name="NavInvertRx" Content="Rx" Margin="0,0,14,0"/><CheckBox x:Name="NavInvertRy" Content="Ry" Margin="0,0,14,0"/><CheckBox x:Name="NavInvertRz" Content="Rz"/>
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource PanelStyle}" Padding="14,11" Margin="0,0,0,10">
                <StackPanel><TextBlock Text="按键映射" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,7"/><UniformGrid x:Name="NavigationButtonsHost" Columns="4"/><TextBlock x:Name="NavigationButtonHelp" Style="{StaticResource SecondaryTextStyle}" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
              </Border>
              <Border Background="{DynamicResource PanelTintBrush}" CornerRadius="10" Padding="14,11">
                <StackPanel><TextBlock Text="使用方法" Style="{StaticResource SectionTitleStyle}"/><TextBlock x:Name="NavigationInstructionsText" FontSize="12" Foreground="{DynamicResource InkBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/><TextBlock Text="启用后切到目标软件即可操控。Ctrl+Alt+F8、断开设备或离开本页都会停止导航。" Style="{StaticResource SecondaryTextStyle}" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <Grid x:Name="SettingsPage" Grid.Row="3" Visibility="Collapsed">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
            <StackPanel>
              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,4,0,0"><TextBlock Text="开机自启动" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="登录后的启动方式" Style="{StaticResource SecondaryTextStyle}" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
                <Border Grid.Column="2" Style="{StaticResource PanelStyle}" Padding="16,14"><StackPanel><CheckBox x:Name="StartupCheckBox" Content="登录 Windows 后打开 SpaceKat 小助手"/><TextBlock x:Name="StartupStatusText" Style="{StaticResource SecondaryTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></Border>
              </Grid>
              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,4,0,0"><TextBlock Text="主题色" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="选择界面强调色" Style="{StaticResource SecondaryTextStyle}" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
                <Border Grid.Column="2" Style="{StaticResource PanelStyle}" Padding="16,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="155"/><ColumnDefinition Width="12"/><ColumnDefinition Width="60"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ComboBox x:Name="ThemePicker" Height="32"/><Border Grid.Column="2" Height="32" Background="{DynamicResource AccentBrush}" CornerRadius="6"/><TextBlock Grid.Column="4" x:Name="ThemeStatusText" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" TextWrapping="Wrap"/></Grid></Border>
              </Grid>
              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,4,0,0"><TextBlock Text="按键布局" Style="{StaticResource SectionTitleStyle}"/></StackPanel>
                <Border Grid.Column="2" Style="{StaticResource PanelStyle}" Padding="16,14">
                  <StackPanel>
                    <StackPanel x:Name="ButtonLayoutRows"/>
                    <WrapPanel Margin="0,10,0,0">
                      <Button x:Name="ButtonLayoutSave" Content="保存" Style="{StaticResource PrimaryButton}" Height="32" Margin="0,0,8,0" AutomationProperties.Name="保存按键布局"/>
                      <Button x:Name="ButtonLayoutReset" Content="恢复默认" Height="32" AutomationProperties.Name="恢复默认按键布局"/>
                    </WrapPanel>
                    <TextBlock x:Name="ButtonLayoutStatus" Style="{StaticResource SecondaryTextStyle}" Margin="0,8,0,0" AutomationProperties.Name="按键布局状态"/>
                  </StackPanel>
                </Border>
              </Grid>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,4,0,0"><TextBlock Text="配置文件" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="导入或导出配置" Style="{StaticResource SecondaryTextStyle}" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
                <Border Grid.Column="2" Style="{StaticResource PanelStyle}" Padding="16,14"><StackPanel><TextBlock Text="选择 SpaceKat 配置 ZIP 或一组配置 TXT 来替换。导入前会自动备份当前配置。" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,0,0,10"/><WrapPanel><Button x:Name="ImportConfigurationButton" Content="导入并替换" Style="{StaticResource PrimaryButton}" Height="32" Margin="0,0,8,0"/><Button x:Name="ExportConfigurationButton" Content="导出配置 ZIP" Height="32"/></WrapPanel><TextBlock x:Name="ConfigurationStatusText" Style="{StaticResource SecondaryTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></Border>
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
