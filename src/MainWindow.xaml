<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#E7EBF2" FontFamily="Segoe UI Variable Text, Microsoft YaHei UI"
             FontSize="13" Foreground="#15233B" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <UserControl.Resources>
    <SolidColorBrush x:Key="AccentBrush" Color="#008F87"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#17383F"/>
    <SolidColorBrush x:Key="AccentTintBrush" Color="#E8F6F2"/>
    <SolidColorBrush x:Key="AccentEdgeBrush" Color="#64B6A8"/>
    <SolidColorBrush x:Key="InkBrush" Color="#15233B"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#505F76"/>
    <SolidColorBrush x:Key="LineBrush" Color="#DCE3EE"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PanelTintBrush" Color="#F0F3F8"/>
    <SolidColorBrush x:Key="DarkPanelBrush" Color="#162438"/>
    <SolidColorBrush x:Key="RailDotBrush" Color="#7689A4"/>
    <SolidColorBrush x:Key="RailIdleBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="RailTextBrush" Color="#34465F"/>
    <SolidColorBrush x:Key="PressedBrush" Color="#CAD5E5"/>
    <SolidColorBrush x:Key="InputLineBrush" Color="#CDD7E5"/>
    <SolidColorBrush x:Key="ControlDisabledBrush" Color="#EBEFF5"/>

    <Style x:Key="PanelStyle" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="16"/>
    </Style>
    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
    </Style>
    <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style TargetType="Button">
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="Background" Value="{StaticResource PanelTintBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="7" Padding="{TemplateBinding Padding}">
              <Grid>
                <Border x:Name="PointerWash" Background="Transparent" Margin="-2"/>
                <ContentPresenter RecognizesAccessKey="True" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="PointerWash" Property="Background" Value="#150B2649"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="PointerWash" Property="Background" Value="#280E2A42"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.48"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource DarkPanelBrush}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="{StaticResource DarkPanelBrush}"/>
    </Style>
    <Style x:Key="NavigationButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Height" Value="40"/>
      <Setter Property="Padding" Value="11,0"/>
      <Setter Property="Background" Value="{StaticResource RailIdleBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource RailIdleBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource RailTextBrush}"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style x:Key="NavIconStyle" TargetType="Path">
      <Setter Property="Width" Value="18"/>
      <Setter Property="Height" Value="17"/>
      <Setter Property="Margin" Value="0,0,10,0"/>
      <Setter Property="Stretch" Value="Uniform"/>
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
      <Setter Property="StrokeThickness" Value="1.5"/>
      <Setter Property="StrokeStartLineCap" Value="Round"/>
      <Setter Property="StrokeEndLineCap" Value="Round"/>
      <Setter Property="StrokeLineJoin" Value="Round"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="9,0,28,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource InputLineBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <Border x:Name="ComboFrame" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7"/>
              <ToggleButton Focusable="False" ClickMode="Press" Background="Transparent"
                            IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent">
                      <Path Data="M 1,1 L 5,5 L 9,1" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.5"
                            StrokeLineJoin="Round" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    </Border>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter IsHitTestVisible="False" Margin="10,0,27,0" VerticalAlignment="Center"
                                Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
              <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False">
                <Border Margin="0,4,0,0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource InputLineBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="4"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                  <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ComboFrame" Property="BorderBrush" Value="{DynamicResource AccentEdgeBrush}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="ComboFrame" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter TargetName="ComboFrame" Property="BorderThickness" Value="2"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ComboFrame" Property="Background" Value="{StaticResource ControlDisabledBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Padding" Value="8,7"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="OptionSurface" CornerRadius="4" Padding="{TemplateBinding Padding}" Background="Transparent">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="OptionSurface" Property="Background" Value="{StaticResource PanelTintBrush}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="OptionSurface" Property="Background" Value="{DynamicResource AccentTintBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="OptionSurface" Property="Opacity" Value="0.48"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SliderTrackButton" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Grid Background="Transparent">
              <Border Height="4" VerticalAlignment="Center" CornerRadius="2" Background="{TemplateBinding Background}"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Slider">
      <Setter Property="MinHeight" Value="22"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" VerticalAlignment="Center" Height="22" Minimum="{TemplateBinding Minimum}"
                     Maximum="{TemplateBinding Maximum}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                     Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderTrackButton}" Background="{DynamicResource AccentBrush}"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Width="16" Height="16">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border CornerRadius="8" Background="White" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderTrackButton}" Background="{StaticResource InputLineBrush}"/>
                </Track.IncreaseRepeatButton>
              </Track>
              <Border x:Name="SliderFocus" BorderThickness="1" BorderBrush="Transparent" CornerRadius="6" IsHitTestVisible="False"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="SliderFocus" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="PART_Track" Property="Opacity" Value="0.46"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="198"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid Grid.Column="0" Margin="14,16,12,15">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid Margin="3,2,2,23">
        <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Width="36" Height="36" CornerRadius="9" Background="{StaticResource DarkPanelBrush}" HorizontalAlignment="Left">
          <Path Data="M 5,15 L 10,17 L 14,15 L 14,11 L 10,9 L 5,11 Z M 5,11 L 10,13 L 14,11 M 10,13 L 10,17 M 10,9 L 10,4 M 8,6 L 10,4 L 12,6"
                Width="18" Height="20" Stretch="Uniform" Stroke="White" StrokeThickness="1.4" StrokeLineJoin="Round"
                StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="SpaceKat" FontSize="19" FontWeight="Bold"/>
          <TextBlock Text="Mini II 小助手" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
        </StackPanel>
      </Grid>

      <StackPanel Grid.Row="1">
        <TextBlock Text="操控" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="10,0,0,7"/>
        <Button x:Name="NavigationNavButton" Style="{StaticResource NavigationButton}">
          <StackPanel Orientation="Horizontal">
            <Path Style="{StaticResource NavIconStyle}" Data="M 9,1 L 17,5 L 17,13 L 9,17 L 1,13 L 1,5 Z M 1,5 L 9,9 L 17,5 M 9,9 L 9,17"/>
            <TextBlock VerticalAlignment="Center" Text="3D 导航"/>
          </StackPanel>
        </Button>
        <Button x:Name="TestNavButton" Style="{StaticResource NavigationButton}">
          <StackPanel Orientation="Horizontal">
            <Path Style="{StaticResource NavIconStyle}" Data="M 1,2 H 17 V 16 H 1 Z M 3,9 H 6 L 8,5 L 10,13 L 12,9 H 15"/>
            <TextBlock VerticalAlignment="Center" Text="设备测试"/>
          </StackPanel>
        </Button>
        <Button x:Name="MappingNavButton" Style="{StaticResource NavigationButton}">
          <StackPanel Orientation="Horizontal">
            <Path Style="{StaticResource NavIconStyle}" Data="M 5,7 Q 5,2 9,2 Q 13,2 13,7 V 11 Q 13,16 9,16 Q 5,16 5,11 Z M 9,3 V 7"/>
            <TextBlock VerticalAlignment="Center" Text="鼠标映射"/>
          </StackPanel>
        </Button>
        <Button x:Name="JoystickNavButton" Style="{StaticResource NavigationButton}">
          <StackPanel Orientation="Horizontal">
            <Path Style="{StaticResource NavIconStyle}" Data="M 2,12 L 4,9 H 14 L 16,12 V 15 H 2 Z M 9,9 V 4 M 7,4 A 2,2 0 1 1 11,4 A 2,2 0 1 1 7,4"/>
            <TextBlock VerticalAlignment="Center" Text="摇杆模拟"/>
          </StackPanel>
        </Button>
        <Border Height="1" Background="{StaticResource LineBrush}" Margin="8,13,7,13"/>
        <Button x:Name="SettingsNavButton" Style="{StaticResource NavigationButton}">
          <StackPanel Orientation="Horizontal">
            <Path Style="{StaticResource NavIconStyle}" Data="M 2,4 H 16 M 2,9 H 16 M 2,14 H 16 M 6,2 V 6 M 12,7 V 11 M 7,12 V 16"/>
            <TextBlock VerticalAlignment="Center" Text="设置"/>
          </StackPanel>
        </Button>
      </StackPanel>

      <Border Grid.Row="2" Style="{StaticResource PanelStyle}" Padding="11" Background="#F3F6FA">
        <StackPanel>
          <TextBlock Text="输出状态" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
          <TextBlock x:Name="GlobalMouseStatusText" Text="已关闭" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,10"/>
          <Button x:Name="GlobalStopButton" Content="停止并释放" Height="34" Padding="8,0"
                  Background="#FCECE8" BorderBrush="#ECCFC8" Foreground="#8E362D" FontSize="12"/>
          <TextBlock Text="Ctrl + Alt + F8" FontFamily="Consolas" FontSize="11"
                     Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" HorizontalAlignment="Center"/>
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Column="1" Margin="0,9,9,9" Background="#F7F8FC" BorderBrush="#CFD9E7" BorderThickness="1" CornerRadius="14">
      <Grid Margin="16,13,14,10">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                CornerRadius="10" Padding="10,8">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="设备" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Grid Grid.Column="1" Margin="0,0,8,0">
              <ComboBox x:Name="DeviceSelector" ToolTip="选择要监视的 3D 鼠标" Height="34"/>
              <TextBlock x:Name="NoDeviceText" Text="未找到 3D 鼠标" Foreground="{StaticResource MutedBrush}"
                         Margin="11,0,28,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
            <Button x:Name="RefreshButton" Grid.Column="2" Content="刷新设备" Height="34" Margin="0,0,7,0" Padding="10,0"/>
            <Button x:Name="DemoButton" Grid.Column="3" Content="演示模式" Height="34" Padding="10,0"/>
          </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="2,8,2,10">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Grid VerticalAlignment="Center" Margin="0,0,9,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource RailDotBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusText" Grid.Column="1" Text="正在查找设备…" FontSize="11"
                       Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
          </Grid>
          <Border Grid.Column="1" Background="{StaticResource PanelTintBrush}" CornerRadius="5" Padding="7,3"
                  ToolTip="显示当前选中设备上报的电量。蓝牙连接时每 20 秒读取。">
            <StackPanel Orientation="Horizontal">
              <Grid Width="21" Height="11" Margin="0,0,5,0" VerticalAlignment="Center">
                <Border Width="17" Height="10" HorizontalAlignment="Left" BorderBrush="{StaticResource RailDotBrush}" BorderThickness="1" CornerRadius="2"/>
                <Rectangle Width="2" Height="4" Fill="{StaticResource RailDotBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <Rectangle x:Name="BatteryFill" Width="0" Height="6" Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0"/>
              </Grid>
              <TextBlock x:Name="BatteryText" Text="电量 — · 未连接" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <TextBlock x:Name="RateText" Grid.Column="2" Text="— Hz · 0 帧" FontFamily="Consolas" FontSize="11"
                     Foreground="{StaticResource MutedBrush}" Margin="11,0,0,0" VerticalAlignment="Center"/>
        </Grid>

        <StackPanel Grid.Row="2" Margin="2,0,2,13">
          <TextBlock x:Name="PageTitleText" Text="设备测试" FontSize="30" FontWeight="Bold"/>
          <TextBlock x:Name="PageDescriptionText" Text="六轴实时预览与按键状态" Style="{StaticResource SecondaryTextStyle}" Margin="0,3,0,0"/>
        </StackPanel>

        <Grid x:Name="TestPage" Grid.Row="3">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.08*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource PanelStyle}" Padding="16" Margin="0,0,12,0">
                  <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <TextBlock Text="六轴操控预览" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center"/>
                      <Button x:Name="ResetCubeButton" Grid.Column="1" Content="重置立方体" Height="30" FontSize="11" Padding="10,0"/>
                    </Grid>
                    <Border x:Name="CubeHost" Grid.Row="1" Height="272" Margin="0,14,0,12" Background="{DynamicResource PanelTintBrush}" CornerRadius="8" ClipToBounds="True"/>
                    <TextBlock x:Name="CubeHintText" Grid.Row="2" Text="X / Y / Z 平移 · Rx / Ry / Rz 旋转；松手后停留，重置可回到中心。" Style="{StaticResource SecondaryTextStyle}" FontSize="11" TextWrapping="Wrap"/>
                  </Grid>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource PanelStyle}" Padding="16">
                  <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12">
                      <TextBlock Text="六轴输入" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center"/>
                      <TextBlock Text="原始数值" Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"/>
                    </Grid>
                    <UniformGrid x:Name="AxesHost" Grid.Row="1" Columns="2" Rows="3" Margin="-5,0,-5,-10"/>
                  </Grid>
                </Border>
              </Grid>
              <Border Style="{StaticResource PanelStyle}" Padding="16" Margin="0,12,0,0">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <Grid Margin="0,0,0,12">
                    <TextBlock Text="按键测试" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center"/>
                    <Button x:Name="ResetCountsButton" Content="清零次数" Height="30" Padding="10,0" HorizontalAlignment="Right" FontSize="11"/>
                  </Grid>
                  <UniformGrid x:Name="TestButtonsHost" Grid.Row="1" Columns="4" Rows="1" Margin="-5,0,-5,0"/>
                </Grid>
              </Border>
              <Border Style="{StaticResource PanelStyle}" Padding="16,12" Margin="0,12,0,0">
                <Expander Header="输入详情与按键诊断" Foreground="{DynamicResource InkBrush}" FontSize="12">
                  <StackPanel Margin="0,12,0,0">
                    <TextBlock x:Name="ButtonHelpText" Text="短按四个按键，观察状态和触发次数；在鼠标映射页学习逻辑键编号。" Style="{StaticResource SecondaryTextStyle}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <CheckBox x:Name="RawButtonMode" Content="原始按键兼容读取（保留未声明的实际位）" IsChecked="True" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12" ToolTip="用于核对当前固件的原始按键报告。"/>
                    <Border Background="{DynamicResource DarkPanelBrush}" CornerRadius="8" Padding="14,12">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="最新报文" FontSize="11" Foreground="#AAB9C8"/>
                          <TextBlock x:Name="RawReportText" Text="等待设备发送数据…" FontFamily="Consolas" FontSize="11" Foreground="#EDF2F7" Margin="0,7,0,0" TextWrapping="Wrap"/>
                          <TextBlock x:Name="ButtonMaskText" Text="按键位图：— 已按下：—" FontSize="11" Foreground="#B9C6D2" Margin="0,7,0,0" TextWrapping="Wrap"/>
                          <TextBlock x:Name="LastButtonReportText" Text="最后按键帧：尚未收到" FontSize="11" Foreground="#B9C6D2" Margin="0,7,0,0" TextWrapping="Wrap"/>
                          <Expander Header="按键事件记录" Foreground="#EDF2F7" FontSize="11" Margin="0,9,0,0">
                            <TextBox x:Name="ButtonHistoryText" IsReadOnly="True" Height="104" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Background="{DynamicResource DarkPanelBrush}" Foreground="#EDF2F7" BorderThickness="0"/>
                          </Expander>
                        </StackPanel>
                        <Button x:Name="CopyButton" Grid.Column="1" Content="复制当前值" FontSize="11" Height="30" Margin="12,0,0,0" VerticalAlignment="Top" Background="#344252" Foreground="#EDF2F7" BorderBrush="#526171" Padding="10,0"/>
                      </Grid>
                    </Border>
                  </StackPanel>
                </Expander>
              </Border>
              <TextBlock x:Name="FooterText" Text="测试页只显示设备输入；可在左侧切换到鼠标映射。" Style="{StaticResource SecondaryTextStyle}" FontSize="11" TextWrapping="Wrap" Margin="2,11,2,3"/>
            </StackPanel>
          </ScrollViewer>
        </Grid>

      <Grid x:Name="MappingPage" Grid.Row="3" Visibility="Collapsed">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
          <StackPanel>
            <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="18,16">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="鼠标控制" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button x:Name="MouseToggleButton" Content="开启鼠标控制" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Height="34"/>
                <TextBlock x:Name="MouseStatusText" Grid.Row="1" Text="已关闭 · 开启后 X / Y 控制光标、Z 控制滚轮，四键执行映射" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,18" TextWrapping="Wrap"/>
                <Grid Grid.Row="2">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,24,0">
                    <TextBlock x:Name="MouseSpeedText" Text="速度 900" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                    <Slider x:Name="MouseSpeedSlider" Minimum="100" Maximum="2400" Value="900" TickFrequency="50" IsSnapToTickEnabled="True" ToolTip="偏移越大，移动越快；此处调整整体速度。Windows 指针速度也会影响最终速度。"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="0,0,24,0">
                    <TextBlock x:Name="MouseDeadZoneText" Text="死区 16" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                    <Slider x:Name="MouseDeadZoneSlider" Minimum="0" Maximum="100" Value="16" TickFrequency="1" IsSnapToTickEnabled="True" ToolTip="绝对值不超过死区的 X、Y 输入不移动光标，可用来抑制回中漂移。"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,12,0,0">
                    <CheckBox x:Name="MouseInvertX" Content="反转 X" IsChecked="True" FontSize="11" Margin="0,0,16,0"/>
                    <CheckBox x:Name="MouseInvertY" Content="反转 Y" IsChecked="True" FontSize="11"/>
                  </StackPanel>
                </Grid>
                <Border Grid.Row="3" Background="{StaticResource PanelTintBrush}" CornerRadius="8" Padding="12,10" Margin="0,18,0,0">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="MouseButtonStatusText" Text="左键未锁定 · 开启后四键映射生效" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                    <Button x:Name="ReleaseLeftButton" Grid.Column="1" Content="释放左键" Height="28" FontSize="11" Padding="10,0" IsEnabled="False"/>
                  </Grid>
                </Border>
                <DockPanel Grid.Row="4" Margin="0,12,0,0">
                  <CheckBox x:Name="WheelDominantAxis" DockPanel.Dock="Left" Content="主导轴过滤" IsChecked="True" FontSize="11" Margin="0,0,12,0" VerticalAlignment="Center" ToolTip="光标移动和 Z 滚轮每次只响应一组，松手回中后重新判断。"/>
                  <TextBlock x:Name="WheelDominantStatus" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
              </Grid>
            </Border>
            <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,14,0,0">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="Z 轴滚轮" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="WheelEnabled" Content="启用 Z 滚轮" IsChecked="True" FontSize="11" Margin="0,0,16,0"/>
                    <CheckBox x:Name="WheelInvert" Content="反转方向" FontSize="11"/>
                  </StackPanel>
                </Grid>
                <TextBlock x:Name="WheelStatusText" Text="开启鼠标控制后，Z+ 上滚、Z− 下滚；松手停止。" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,7,0,12" TextWrapping="Wrap"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,22,0">
                    <TextBlock Text="向上滚动" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock x:Name="WheelUpGainText" Text="力度灵敏度 1.0×" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,9,0,4"/>
                    <Slider x:Name="WheelUpGain" Minimum="0.1" Maximum="3" Value="1" TickFrequency="0.1" IsSnapToTickEnabled="True" ToolTip="只调上滚力度，越高越省力。"/>
                    <TextBlock x:Name="WheelUpSpeedText" Text="上滚速度 6 格/秒" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,4"/>
                    <Slider x:Name="WheelUpSpeed" Minimum="1" Maximum="120" Value="6" TickFrequency="1" IsSnapToTickEnabled="True" ToolTip="Z 轴满偏移时的最大上滚速度，以格/秒计。实际滚动距离受系统和目标软件设置影响。"/>
                    <TextBlock x:Name="WheelUpDeadZoneText" Text="回中死区 8%" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,4"/>
                    <Slider x:Name="WheelUpDeadZone" Minimum="0" Maximum="0.4" Value="0.08" TickFrequency="0.01" IsSnapToTickEnabled="True"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="向下滚动" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock x:Name="WheelDownGainText" Text="力度灵敏度 1.0×" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,9,0,4"/>
                    <Slider x:Name="WheelDownGain" Minimum="0.1" Maximum="3" Value="1" TickFrequency="0.1" IsSnapToTickEnabled="True" ToolTip="只调下滚力度，越高越省力。"/>
                    <TextBlock x:Name="WheelDownSpeedText" Text="下滚速度 6 格/秒" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,4"/>
                    <Slider x:Name="WheelDownSpeed" Minimum="1" Maximum="120" Value="6" TickFrequency="1" IsSnapToTickEnabled="True" ToolTip="Z 轴满偏移时的最大下滚速度，以格/秒计。实际滚动距离受系统和目标软件设置影响。"/>
                    <TextBlock x:Name="WheelDownDeadZoneText" Text="回中死区 8%" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,4"/>
                    <Slider x:Name="WheelDownDeadZone" Minimum="0" Maximum="0.4" Value="0.08" TickFrequency="0.01" IsSnapToTickEnabled="True"/>
                  </StackPanel>
                </Grid>
                <WrapPanel Margin="0,13,0,0">
                  <Button x:Name="WheelCalibrateButton" Content="以当前 Z 为中心" Height="28" FontSize="11" Padding="10,0" Margin="0,0,8,0"/>
                  <Button x:Name="WheelClearCenterButton" Content="清除 Z 校准" Height="28" FontSize="11" Padding="10,0" Margin="0,0,12,0"/>
                  <TextBlock x:Name="WheelCenterText" Text="Z 中心 0" FontSize="10" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                </WrapPanel>
              </StackPanel>
            </Border>
            <StackPanel Margin="1,22,1,13">
              <TextBlock Text="选择四键鼠标功能" FontSize="16" FontWeight="SemiBold"/>
              <TextBlock Text="每个按键独立设置；“左键锁定 / 释放”按一次保持按住，再按一次松开。" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0" TextWrapping="Wrap"/>
              <TextBlock x:Name="MappingHelpText" Text="先确认四个物理按键对应的逻辑键编号，再选择鼠标功能。" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <UniformGrid x:Name="ButtonsHost" Columns="4" Rows="1" Margin="-5,0,-5,0"/>
            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="1,13,1,0" Margin="0,20,0,0">
              <TextBlock Text="切回设备测试会停止鼠标控制并释放锁定；也可以随时按 Ctrl+Alt+F8，或点击左侧“停止并释放”。" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <Grid x:Name="JoystickPage" Grid.Row="3" Visibility="Collapsed">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
          <StackPanel>
            <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="15,12" Margin="0,0,0,14">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="输出目标" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,12,0"/>
                <ComboBox x:Name="StickOutputMode" Grid.Column="1" Height="32" Margin="0,0,14,0"/>
                <Button x:Name="StickToggleButton" Grid.Column="2" Content="开启摇杆模拟" Style="{StaticResource PrimaryButton}" Height="32"/>
                <TextBlock x:Name="StickStatusText" Grid.Row="1" Grid.ColumnSpan="3" Text="已关闭 · 右摇杆回中" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,9,0,0" TextWrapping="Wrap"/>
                <DockPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,10,0,0">
                  <CheckBox x:Name="StickDominantAxis" DockPanel.Dock="Left" Content="主导轴过滤" IsChecked="True" FontSize="11" Margin="0,0,12,0" VerticalAlignment="Center" ToolTip="转向和 Z 缩放每次只响应一组，松手回中后重新判断。"/>
                  <TextBlock x:Name="StickDominantStatus" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
              </Grid>
            </Border>
            <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="15,12" Margin="0,0,0,14">
              <StackPanel>
                <DockPanel>
                  <TextBlock x:Name="StickButtonState" DockPanel.Dock="Right" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                  <TextBlock Text="手柄按键映射" FontSize="14" FontWeight="SemiBold"/>
                </DockPanel>
                <UniformGrid x:Name="StickButtonsHost" Columns="4" Rows="1" Margin="-4,9,-4,0"/>
                <TextBlock Text="按键编号沿用鼠标映射页。设为实体启停的键只负责启停。" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <Grid x:Name="StickPreviewGrid">
              <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="*" MinWidth="210"/></Grid.ColumnDefinitions>
              <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,14,0">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <TextBlock Text="固定中心视角" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  <Button x:Name="StickResetViewButton" Content="重置视角与缩放" HorizontalAlignment="Right" Height="27" FontSize="10" Padding="9,0"/>
                  <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="175"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="预览大小" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    <Slider x:Name="StickPreviewSize" Grid.Column="1" TickFrequency="5" SmallChange="5" LargeChange="15"
                            IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="10,0"
                            AutomationProperties.Name="预览大小" ToolTip="调整预览区域的宽度和高度"/>
                    <TextBlock x:Name="StickPreviewSizeText" Grid.Column="2" Text="100%" MinWidth="44" TextAlignment="Right"
                               FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                  </Grid>
                  <Border x:Name="StickCameraHost" Grid.Row="2" Margin="0,9,0,8" CornerRadius="8" Background="#F5FAFB" ClipToBounds="True"/>
                  <TextBlock x:Name="StickCameraText" Grid.Row="3" Text="Yaw 0° · Pitch 0° · 位置 (0,0,0) · Roll 0°" FontSize="10" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                </Grid>
              </Border>
              <Border Grid.Column="1" VerticalAlignment="Top" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="14,12">
                <StackPanel>
                  <TextBlock Text="右摇杆 · RIGHT STICK" FontSize="14" FontWeight="SemiBold"/>
                  <Border x:Name="RightStickHost" Height="205" Margin="0,8,0,4"/>
                  <TextBlock x:Name="StickValueText" Text="X 0.000   Y 0.000" FontFamily="Consolas" FontSize="17" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                  <TextBlock x:Name="StickIntegerText" Text="RX 0   RY 0" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>
            </Grid>
            <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="15,13" Margin="0,14,0,0">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="Z 轴缩放 · LT / RT" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="ZoomEnabled" Content="启用 Z 轴" IsChecked="True" FontSize="11" Margin="0,0,16,0"/>
                    <CheckBox x:Name="ZoomInvert" Content="反转方向" FontSize="11"/>
                  </StackPanel>
                </Grid>
                <Grid Margin="0,10,0,9">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,18,0">
                    <Grid><TextBlock Text="LT · 缩小" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock x:Name="ZoomLeftValue" Text="0 / 255" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{DynamicResource AccentBrush}" FontSize="11"/></Grid>
                    <ProgressBar x:Name="ZoomLeftMeter" Minimum="0" Maximum="255" Value="0" Height="6" Foreground="{DynamicResource AccentBrush}" Background="{StaticResource ControlDisabledBrush}" BorderThickness="0" Margin="0,5,0,0"/>
                    <TextBlock x:Name="ZoomOutGainText" Text="力度灵敏度 1.0×" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,4"/>
                    <Slider x:Name="ZoomOutGain" Minimum="0.1" Maximum="3" Value="1" TickFrequency="0.1" IsSnapToTickEnabled="True" ToolTip="只调节缩小的力度，越高越省力。"/>
                    <TextBlock x:Name="ZoomOutSpeedText" Text="缩小速度 50%" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,4"/>
                    <Slider x:Name="ZoomOutSpeed" Minimum="5" Value="50" TickFrequency="5" IsSnapToTickEnabled="True" ToolTip="超过 100% 时，本页缩小更快，虚拟扳机在较小的 Z 轴偏移时达到满值。"/>
                    <TextBlock x:Name="ZoomOutDeadZoneText" Text="回中死区 8%" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,4"/>
                    <Slider x:Name="ZoomOutDeadZone" Minimum="0" Maximum="0.4" Value="0.08" TickFrequency="0.01" IsSnapToTickEnabled="True" ToolTip="只调节缩小方向的回中死区。"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <Grid><TextBlock Text="RT · 放大" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock x:Name="ZoomRightValue" Text="0 / 255" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{DynamicResource AccentBrush}" FontSize="11"/></Grid>
                    <ProgressBar x:Name="ZoomRightMeter" Minimum="0" Maximum="255" Value="0" Height="6" Foreground="{DynamicResource AccentBrush}" Background="{StaticResource ControlDisabledBrush}" BorderThickness="0" Margin="0,5,0,0"/>
                    <TextBlock x:Name="ZoomInGainText" Text="力度灵敏度 1.0×" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,4"/>
                    <Slider x:Name="ZoomInGain" Minimum="0.1" Maximum="3" Value="1" TickFrequency="0.1" IsSnapToTickEnabled="True" ToolTip="只调节放大的力度，越高越省力。"/>
                    <TextBlock x:Name="ZoomInSpeedText" Text="放大速度 50%" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,4"/>
                    <Slider x:Name="ZoomInSpeed" Minimum="5" Value="50" TickFrequency="5" IsSnapToTickEnabled="True" ToolTip="超过 100% 时，本页放大更快，虚拟扳机在较小的 Z 轴偏移时达到满值。"/>
                    <TextBlock x:Name="ZoomInDeadZoneText" Text="回中死区 8%" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,4"/>
                    <Slider x:Name="ZoomInDeadZone" Minimum="0" Maximum="0.4" Value="0.08" TickFrequency="0.01" IsSnapToTickEnabled="True" ToolTip="只调节放大方向的回中死区。"/>
                  </StackPanel>
                </Grid>
                <TextBlock x:Name="ZoomHintText" Text="Z+ 放大 · Z− 缩小。两方向的力度、速度和死区分别调节；外部软件需绑定 LT / RT 到缩放。" FontSize="10" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
              </StackPanel>
            </Border>
            <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="15,13" Margin="0,14,0,0">
              <StackPanel>
                <TextBlock Text="轴映射与手感" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock Text="内置设置使用平移 X / Y，推动操纵帽控制左右和上下。可在下方选择其他通道。" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6,0,12" TextWrapping="Wrap"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,18,0">
                    <TextBlock Text="右摇杆 X · 左右看" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5"/>
                    <ComboBox x:Name="StickSourceX" Height="30"/>
                    <CheckBox x:Name="StickInvertX" Content="反转 X" FontSize="11" Margin="0,8,0,0"/>
                    <TextBlock x:Name="StickGainXText" Text="X 增益 1.0" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,11,0,5"/>
                    <Slider x:Name="StickGainX" Minimum="0.1" Maximum="3" Value="1" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="右摇杆 Y · 上下看" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5"/>
                    <ComboBox x:Name="StickSourceY" Height="30"/>
                    <CheckBox x:Name="StickInvertY" Content="反转 Y" IsChecked="True" FontSize="11" Margin="0,8,0,0"/>
                    <TextBlock x:Name="StickGainYText" Text="Y 增益 1.0" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,11,0,5"/>
                    <Slider x:Name="StickGainY" Minimum="0.1" Maximum="3" Value="1" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                  </StackPanel>
                </Grid>
                <Grid Margin="0,13,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,18,0"><TextBlock x:Name="StickDeadZoneText" Text="径向死区 0.08" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/><Slider x:Name="StickDeadZone" Minimum="0" Maximum="0.4" Value="0.08" TickFrequency="0.01" IsSnapToTickEnabled="True"/></StackPanel>
                  <StackPanel Grid.Column="1" Margin="0,0,18,0"><TextBlock x:Name="StickGammaText" Text="响应曲线 1.5" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/><Slider x:Name="StickGamma" Minimum="1" Maximum="3" Value="1.5" TickFrequency="0.1" IsSnapToTickEnabled="True"/></StackPanel>
                  <StackPanel Grid.Column="2"><TextBlock Text="实体按键启停" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/><ComboBox x:Name="StickToggleKey" Height="28" FontSize="11"/></StackPanel>
                </Grid>
                <WrapPanel Margin="0,14,0,0">
                  <Button x:Name="StickCalibrateButton" Content="以当前位置为中心" Height="28" FontSize="11" Padding="10,0" Margin="0,0,8,0"/>
                  <Button x:Name="StickClearCenterButton" Content="清除校准" Height="28" FontSize="11" Padding="10,0" Margin="0,0,12,0"/>
                  <TextBlock x:Name="StickCenterText" Text="中心：未校准" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                </WrapPanel>
              </StackPanel>
            </Border>
            <TextBlock Text="持续偏转持续转向或缩放；松手后停止并保留视角与倍率。150 ms 无新数据时，右摇杆和两扳机归零。虚拟手柄需由目标软件绑定相应功能。" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="2,12,2,5"/>
          </StackPanel>
        </ScrollViewer>
      </Grid>
        <Grid x:Name="NavigationPage" Grid.Row="3" Visibility="Collapsed">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
            <StackPanel>
              <Border Background="{DynamicResource DarkPanelBrush}" CornerRadius="12" Padding="13,11" Margin="0,0,0,8">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="导航方式" Foreground="White" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0,14,0"/>
