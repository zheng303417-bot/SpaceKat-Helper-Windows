<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F7F8" FontFamily="Microsoft YaHei UI" FontSize="13"
             Foreground="#193138" UseLayoutRounding="True">
  <UserControl.Resources>
    <SolidColorBrush x:Key="AccentBrush" Color="#008F87"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#17383F"/>
    <SolidColorBrush x:Key="AccentTintBrush" Color="#E8F6F2"/>
    <SolidColorBrush x:Key="AccentEdgeBrush" Color="#64B6A8"/>
    <Style TargetType="Button">
      <Setter Property="Height" Value="38"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="Background" Value="#EDF3F4"/>
      <Setter Property="Foreground" Value="#29474F"/>
      <Setter Property="BorderBrush" Value="#DEE8EA"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.65"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentEdgeBrush}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style x:Key="NavigationButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Height" Value="54"/><Setter Property="Padding" Value="14,0"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="#A8C1C7"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style TargetType="ComboBox"><Setter Property="Height" Value="36"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Padding" Value="8,3"/></Style>
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="174"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}">
      <Grid Margin="17,28,17,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="9,0,0,34">
          <TextBlock Text="SpaceKat" FontFamily="Segoe UI" FontSize="21" FontWeight="Bold" Foreground="White"/>
          <TextBlock Text="小助手 · MINI II" FontSize="11" Foreground="#9EC9C7" Margin="1,7,0,0"/>
          <Border Width="28" Height="3" Background="{DynamicResource AccentEdgeBrush}" HorizontalAlignment="Left" Margin="1,18,0,0" CornerRadius="1"/>
        </StackPanel>
        <StackPanel Grid.Row="1">
          <TextBlock Text="工作空间" FontSize="10" Foreground="#72979D" Margin="14,0,0,12"/>
          <Button x:Name="TestNavButton" Style="{StaticResource NavigationButton}" Background="{DynamicResource AccentBrush}" Foreground="White">
            <StackPanel Orientation="Horizontal"><TextBlock Text="01" FontFamily="Consolas" FontSize="11" Margin="0,0,12,0" VerticalAlignment="Center"/><TextBlock Text="设备测试" FontWeight="SemiBold"/></StackPanel>
          </Button>
          <Button x:Name="MappingNavButton" Style="{StaticResource NavigationButton}">
            <StackPanel Orientation="Horizontal"><TextBlock Text="02" FontFamily="Consolas" FontSize="11" Margin="0,0,12,0" VerticalAlignment="Center"/><TextBlock Text="鼠标映射" FontWeight="SemiBold"/></StackPanel>
          </Button>
          <Button x:Name="JoystickNavButton" Style="{StaticResource NavigationButton}">
            <StackPanel Orientation="Horizontal"><TextBlock Text="03" FontFamily="Consolas" FontSize="11" Margin="0,0,12,0" VerticalAlignment="Center"/><TextBlock Text="摇杆模拟" FontWeight="SemiBold"/></StackPanel>
          </Button>
        <Button x:Name="SettingsNavButton" Style="{StaticResource NavigationButton}">
          <StackPanel Orientation="Horizontal"><TextBlock Text="04" FontFamily="Consolas" FontSize="11" Margin="0,0,12,0" VerticalAlignment="Center"/><TextBlock Text="设置" FontWeight="SemiBold"/></StackPanel>
        </Button>
        </StackPanel>
        <StackPanel Grid.Row="3">
          <Border Height="1" Background="#33545A" Margin="5,0,5,16"/>
          <TextBlock Text="输出状态" FontSize="10" Foreground="#80AAA9" Margin="5,0,0,7"/>
          <TextBlock x:Name="GlobalMouseStatusText" Text="已关闭" FontSize="12" Foreground="#C9E0E3" TextWrapping="Wrap" Margin="5,0,5,13"/>
          <Button x:Name="GlobalStopButton" Content="停止并释放" Height="36" Padding="8,0" Background="#31565F" BorderBrush="#4E737A" Foreground="White" FontSize="12"/>
          <TextBlock Text="Ctrl + Alt + F8" FontFamily="Consolas" FontSize="11" Foreground="#A8C1C7" Margin="5,14,0,4"/>
          <TextBlock Text="全局停止当前模拟" FontSize="10" Foreground="#72979D" Margin="5,0,0,0"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1" Margin="24,20,22,12">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Margin="1,0,1,16">
        <StackPanel Margin="0,0,145,0">
          <TextBlock x:Name="PageTitleText" Text="设备测试" FontSize="26" FontWeight="SemiBold"/>
          <TextBlock x:Name="PageDescriptionText" Text="六轴实时预览与按键状态" FontSize="12" Foreground="#71868C" Margin="0,5,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <Border Background="White" BorderBrush="#DFE8EA" BorderThickness="1" CornerRadius="14" Padding="12,6" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,0,0">
          <TextBlock Text="Mini II · USB / 蓝牙" FontSize="10" Foreground="#5B747C"/>
        </Border>
      </Grid>

      <Border Grid.Row="1" Background="White" BorderBrush="#DFE8EA" BorderThickness="1" CornerRadius="11" Padding="12,10">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Grid Margin="0,0,12,0">
            <ComboBox x:Name="DeviceSelector" ToolTip="选择要监视的 3D 鼠标"/>
            <TextBlock x:Name="NoDeviceText" Text="未找到 3D 鼠标" Foreground="#72878D" Margin="12,0,30,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
          </Grid>
          <Button x:Name="RefreshButton" Grid.Column="1" Content="刷新设备" Margin="0,0,8,0" Height="36" Padding="12,0"/>
          <Button x:Name="DemoButton" Grid.Column="2" Content="演示模式" Style="{StaticResource PrimaryButton}" Height="36" Padding="12,0"/>
        </Grid>
      </Border>
      <Grid Grid.Row="2" Margin="3,10,3,13">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#93A5AA" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBlock x:Name="StatusText" Text="正在查找设备…" FontSize="11" Foreground="#607A82" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <Border Grid.Column="1" Background="#EDF3F4" CornerRadius="8" Margin="8,0,0,0" Padding="7,3"
                ToolTip="显示当前选中设备上报的电量。蓝牙连接时每 20 秒读取。">
          <StackPanel Orientation="Horizontal">
            <Grid Width="21" Height="11" Margin="0,0,5,0" VerticalAlignment="Center">
              <Border Width="17" Height="10" HorizontalAlignment="Left" BorderBrush="#789298" BorderThickness="1" CornerRadius="2"/>
              <Rectangle Width="2" Height="4" Fill="#789298" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,1,0"/>
              <Rectangle x:Name="BatteryFill" Width="0" Height="6" Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0"/>
            </Grid>
            <TextBlock x:Name="BatteryText" Text="电量 — · 未连接" FontSize="11" Foreground="#607A82" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
        <TextBlock x:Name="RateText" Grid.Column="2" Text="— Hz · 0 帧" FontFamily="Consolas" FontSize="11" Foreground="#7B9198" Margin="12,0,0,0" VerticalAlignment="Center"/>
      </Grid>

      <Grid x:Name="TestPage" Grid.Row="3">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Grid.Column="0" Background="White" BorderBrush="#DFE8EA" BorderThickness="1" CornerRadius="12" Padding="14,12,14,10" Margin="0,0,14,0">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <TextBlock Text="六轴操控预览" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  <Button x:Name="ResetCubeButton" Content="重置立方体" Height="28" FontSize="10" Padding="10,0" HorizontalAlignment="Right"/>
                  <Border x:Name="CubeHost" Grid.Row="1" Height="280" Margin="0,9,0,5" Background="#F6FAFA" CornerRadius="8" ClipToBounds="True"/>
                  <TextBlock x:Name="CubeHintText" Grid.Row="2" Text="X / Y / Z 平移 · Rx / Ry / Rz 旋转；松手后停留，重置可回到中心。" FontSize="10" Foreground="#71868C" TextWrapping="Wrap"/>
                </Grid>
              </Border>
              <Grid Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Margin="1,3,1,10">
                  <TextBlock Text="六轴输入" FontSize="14" FontWeight="SemiBold"/>
                  <TextBlock Text="原始数值" HorizontalAlignment="Right" FontSize="10" Foreground="#7A9097" VerticalAlignment="Center"/>
                </Grid>
                <UniformGrid x:Name="AxesHost" Grid.Row="1" Columns="2" Rows="3" Margin="-5,0,-5,-10"/>
              </Grid>
            </Grid>

            <Grid Margin="1,16,1,10">
              <TextBlock Text="按键测试" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <Button x:Name="ResetCountsButton" Content="清零次数" Height="28" Padding="10,0" HorizontalAlignment="Right" FontSize="10"/>
            </Grid>
            <UniformGrid x:Name="TestButtonsHost" Columns="4" Rows="1" Margin="-5,0,-5,0"/>

            <Border Background="White" BorderBrush="#DFE8EA" BorderThickness="1" CornerRadius="10" Padding="13,9" Margin="0,14,0,0">
              <Expander Header="输入详情与按键诊断" Foreground="#607A82" FontSize="11">
                <StackPanel Margin="2,8,2,3">
                  <TextBlock x:Name="ButtonHelpText" Text="短按四个按键，观察状态和触发次数；在鼠标映射页学习逻辑键编号。" Foreground="#7A9097" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                  <CheckBox x:Name="RawButtonMode" Content="原始按键兼容读取（保留未声明的实际位）" IsChecked="True" FontSize="11" Foreground="#607A82" Margin="0,0,0,12" ToolTip="用于核对当前固件的原始按键报告。"/>
                  <Border Background="#19343B" CornerRadius="8" Padding="13,11">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="最新报文" FontSize="10" Foreground="#93B1B8"/>
                        <TextBlock x:Name="RawReportText" Text="等待设备发送数据…" FontFamily="Consolas" FontSize="11" Foreground="#DAECEF" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ButtonMaskText" Text="按键位图：— 已按下：—" FontSize="10" Foreground="#9DBBC2" Margin="0,7,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="LastButtonReportText" Text="最后按键帧：尚未收到" FontSize="10" Foreground="#9DBBC2" Margin="0,7,0,0" TextWrapping="Wrap"/>
                        <Expander Header="按键事件记录" Foreground="#DAECEF" FontSize="10" Margin="0,7,0,0">
                          <TextBox x:Name="ButtonHistoryText" IsReadOnly="True" Height="104" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Background="#19343B" Foreground="#DAECEF" BorderThickness="0"/>
                        </Expander>
                      </StackPanel>
                      <Button x:Name="CopyButton" Grid.Column="1" Content="复制当前值" FontSize="10" Height="28" Margin="12,0,0,0" VerticalAlignment="Top" Background="#2B4B54" Foreground="#D3E7EA" BorderBrush="#385B65" Padding="9,0"/>
                    </Grid>
                  </Border>
                </StackPanel>
              </Expander>
            </Border>
            <TextBlock x:Name="FooterText" Text="测试页只显示设备输入；可在左侧切换到鼠标映射。" FontSize="10" Foreground="#82969C" TextWrapping="Wrap" Margin="2,11,2,3"/>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <Grid x:Name="MappingPage" Grid.Row="3" Visibility="Collapsed">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
          <StackPanel>
            <Border Background="White" BorderBrush="#DFE8EA" BorderThickness="1" CornerRadius="12" Padding="18,16">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="鼠标控制" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button x:Name="MouseToggleButton" Content="开启鼠标控制" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Height="34"/>
                <TextBlock x:Name="MouseStatusText" Grid.Row="1" Text="已关闭 · 开启后 X / Y 控制光标、Z 控制滚轮，四键执行映射" FontSize="11" Foreground="#71868C" Margin="0,10,0,18" TextWrapping="Wrap"/>
                <Grid Grid.Row="2">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,24,0">
                    <TextBlock x:Name="MouseSpeedText" Text="速度 900" FontSize="11" Foreground="#607A82" Margin="0,0,0,8"/>
                    <Slider x:Name="MouseSpeedSlider" Minimum="100" Maximum="2400" Value="900" TickFrequency="50" IsSnapToTickEnabled="True" ToolTip="偏移越大，移动越快；此处调整整体速度。Windows 指针速度也会影响最终速度。"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="0,0,24,0">
                    <TextBlock x:Name="MouseDeadZoneText" Text="死区 16" FontSize="11" Foreground="#607A82" Margin="0,0,0,8"/>
                    <Slider x:Name="MouseDeadZoneSlider" Minimum="0" Maximum="100" Value="16" TickFrequency="1" IsSnapToTickEnabled="True" ToolTip="绝对值不超过死区的 X、Y 输入不移动光标，可用来抑制回中漂移。"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,12,0,0">
                    <CheckBox x:Name="MouseInvertX" Content="反转 X" IsChecked="True" FontSize="11" Margin="0,0,16,0"/>
                    <CheckBox x:Name="MouseInvertY" Content="反转 Y" IsChecked="True" FontSize="11"/>
                  </StackPanel>
                </Grid>
                <Border Grid.Row="3" Background="#F4F8F8" CornerRadius="8" Padding="12,10" Margin="0,18,0,0">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="MouseButtonStatusText" Text="左键未锁定 · 开启后四键映射生效" Foreground="#71868C" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                    <Button x:Name="ReleaseLeftButton" Grid.Column="1" Content="释放左键" Height="28" FontSize="11" Padding="10,0" IsEnabled="False"/>
                  </Grid>
                </Border>
                <DockPanel Grid.Row="4" Margin="0,12,0,0">
                  <CheckBox x:Name="WheelDominantAxis" DockPanel.Dock="Left" Content="主导轴过滤" IsChecked="True" FontSize="11" Margin="0,0,12,0" VerticalAlignment="Center" ToolTip="光标移动和 Z 滚轮每次只响应一组，松手回中后重新判断。"/>
                  <TextBlock x:Name="WheelDominantStatus" Foreground="#71868C" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
              </Grid>
            </Border>
            <Border Background="White" BorderBrush="#DFE8EA" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,14,0,0">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="Z 轴滚轮" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="WheelEnabled" Content="启用 Z 滚轮" IsChecked="True" FontSize="11" Margin="0,0,16,0"/>
                    <CheckBox x:Name="WheelInvert" Content="反转方向" FontSize="11"/>
                  </StackPanel>
                </Grid>
                <TextBlock x:Name="WheelStatusText" Text="开启鼠标控制后，Z+ 上滚、Z− 下滚；松手停止。" Foreground="#71868C" FontSize="11" Margin="0,7,0,12" TextWrapping="Wrap"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,22,0">
                    <TextBlock Text="向上滚动" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock x:Name="WheelUpGainText" Text="力度灵敏度 1.0×" FontSize="11" Foreground="#607A82" Margin="0,9,0,4"/>
                    <Slider x:Name="WheelUpGain" Minimum="0.1" Maximum="3" Value="1" TickFrequency="0.1" IsSnapToTickEnabled="True" ToolTip="只调上滚力度，越高越省力。"/>
                    <TextBlock x:Name="WheelUpSpeedText" Text="上滚速度 6 格/秒" FontSize="11" Foreground="#607A82" Margin="0,8,0,4"/>
                    <Slider x:Name="WheelUpSpeed" Minimum="1" Maximum="120" Value="6" TickFrequency="1" IsSnapToTickEnabled="True" ToolTip="Z 轴满偏移时的最大上滚速度，以格/秒计。实际滚动距离受系统和目标软件设置影响。"/>
                    <TextBlock x:Name="WheelUpDeadZoneText" Text="回中死区 8%" FontSize="11" Foreground="#607A82" Margin="0,8,0,4"/>
                    <Slider x:Name="WheelUpDeadZone" Minimum="0" Maximum="0.4" Value="0.08" TickFrequency="0.01" IsSnapToTickEnabled="True"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="向下滚动" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock x:Name="WheelDownGainText" Text="力度灵敏度 1.0×" FontSize="11" Foreground="#607A82" Margin="0,9,0,4"/>
                    <Slider x:Name="WheelDownGain" Minimum="0.1" Maximum="3" Value="1" TickFrequency="0.1" IsSnapToTickEnabled="True" ToolTip="只调下滚力度，越高越省力。"/>
                    <TextBlock x:Name="WheelDownSpeedText" Text="下滚速度 6 格/秒" FontSize="11" Foreground="#607A82" Margin="0,8,0,4"/>
                    <Slider x:Name="WheelDownSpeed" Minimum="1" Maximum="120" Value="6" TickFrequency="1" IsSnapToTickEnabled="True" ToolTip="Z 轴满偏移时的最大下滚速度，以格/秒计。实际滚动距离受系统和目标软件设置影响。"/>
                    <TextBlock x:Name="WheelDownDeadZoneText" Text="回中死区 8%" FontSize="11" Foreground="#607A82" Margin="0,8,0,4"/>
                    <Slider x:Name="WheelDownDeadZone" Minimum="0" Maximum="0.4" Value="0.08" TickFrequency="0.01" IsSnapToTickEnabled="True"/>
                  </StackPanel>
                </Grid>
                <WrapPanel Margin="0,13,0,0">
                  <Button x:Name="WheelCalibrateButton" Content="以当前 Z 为中心" Height="28" FontSize="11" Padding="10,0" Margin="0,0,8,0"/>
                  <Button x:Name="WheelClearCenterButton" Content="清除 Z 校准" Height="28" FontSize="11" Padding="10,0" Margin="0,0,12,0"/>
                  <TextBlock x:Name="WheelCenterText" Text="Z 中心 0" FontSize="10" Foreground="#71868C" VerticalAlignment="Center"/>
                </WrapPanel>
              </StackPanel>
            </Border>
            <StackPanel Margin="1,22,1,13">
              <TextBlock Text="选择四键鼠标功能" FontSize="16" FontWeight="SemiBold"/>
              <TextBlock Text="每个按键独立设置；“左键锁定 / 释放”按一次保持按住，再按一次松开。" FontSize="11" Foreground="#71868C" Margin="0,7,0,0" TextWrapping="Wrap"/>
              <TextBlock x:Name="MappingHelpText" Text="先确认四个物理按键对应的逻辑键编号，再选择鼠标功能。" FontSize="11" Foreground="#71868C" Margin="0,7,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <UniformGrid x:Name="ButtonsHost" Columns="4" Rows="1" Margin="-5,0,-5,0"/>
            <Border BorderBrush="#DDE7E9" BorderThickness="0,1,0,0" Padding="1,13,1,0" Margin="0,20,0,0">
              <TextBlock Text="切回设备测试会停止鼠标控制并释放锁定；也可以随时按 Ctrl+Alt+F8，或点击左侧“停止并释放”。" FontSize="11" Foreground="#71868C" TextWrapping="Wrap"/>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <Grid x:Name="JoystickPage" Grid.Row="3" Visibility="Collapsed">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
          <StackPanel>
            <Border Background="White" BorderBrush="#DFE8EA" BorderThickness="1" CornerRadius="12" Padding="15,12" Margin="0,0,0,14">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="输出目标" VerticalAlignment="Center" Foreground="#607A82" FontSize="11" Margin="0,0,12,0"/>
                <ComboBox x:Name="StickOutputMode" Grid.Column="1" Height="32" Margin="0,0,14,0"/>
                <Button x:Name="StickToggleButton" Grid.Column="2" Content="开启摇杆模拟" Style="{StaticResource PrimaryButton}" Height="32"/>
                <TextBlock x:Name="StickStatusText" Grid.Row="1" Grid.ColumnSpan="3" Text="已关闭 · 右摇杆回中" Foreground="#71868C" FontSize="11" Margin="0,9,0,0" TextWrapping="Wrap"/>
                <DockPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,10,0,0">
                  <CheckBox x:Name="StickDominantAxis" DockPanel.Dock="Left" Content="主导轴过滤" IsChecked="True" FontSize="11" Margin="0,0,12,0" VerticalAlignment="Center" ToolTip="转向和 Z 缩放每次只响应一组，松手回中后重新判断。"/>
                  <TextBlock x:Name="StickDominantStatus" Foreground="#71868C" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
              </Grid>
            </Border>
            <Border Background="White" BorderBrush="#DFE8EA" BorderThickness="1" CornerRadius="12" Padding="15,12" Margin="0,0,0,14">
              <StackPanel>
                <DockPanel>
                  <TextBlock x:Name="StickButtonState" DockPanel.Dock="Right" FontSize="11" Foreground="#607A82" VerticalAlignment="Center"/>
                  <TextBlock Text="手柄按键映射" FontSize="14" FontWeight="SemiBold"/>
                </DockPanel>
                <UniformGrid x:Name="StickButtonsHost" Columns="4" Rows="1" Margin="-4,9,-4,0"/>
                <TextBlock Text="按键编号沿用鼠标映射页。设为实体启停的键只负责启停。" FontSize="10" Foreground="#71868C" Margin="0,7,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Background="White" BorderBrush="#DFE8EA" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,14,0">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <TextBlock Text="固定中心视角" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  <Button x:Name="StickResetViewButton" Content="重置视角与缩放" HorizontalAlignment="Right" Height="27" FontSize="10" Padding="9,0"/>
                  <Border x:Name="StickCameraHost" Grid.Row="1" Height="245" Margin="0,9,0,8" CornerRadius="8" Background="#F5FAFB" ClipToBounds="True"/>
                  <TextBlock x:Name="StickCameraText" Grid.Row="2" Text="Yaw 0° · Pitch 0° · 位置 (0,0,0) · Roll 0°" FontSize="10" Foreground="#71868C" TextWrapping="Wrap"/>
                </Grid>
              </Border>
              <Border Grid.Column="1" Background="White" BorderBrush="#DFE8EA" BorderThickness="1" CornerRadius="12" Padding="14,12">
                <StackPanel>
                  <TextBlock Text="右摇杆 · RIGHT STICK" FontSize="14" FontWeight="SemiBold"/>
                  <Border x:Name="RightStickHost" Height="205" Margin="0,8,0,4"/>
                  <TextBlock x:Name="StickValueText" Text="X 0.000   Y 0.000" FontFamily="Consolas" FontSize="17" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                  <TextBlock x:Name="StickIntegerText" Text="RX 0   RY 0" FontFamily="Consolas" FontSize="10" Foreground="#71868C" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>
            </Grid>
            <Border Background="White" BorderBrush="#DFE8EA" BorderThickness="1" CornerRadius="12" Padding="15,13" Margin="0,14,0,0">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="Z 轴缩放 · LT / RT" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="ZoomEnabled" Content="启用 Z 轴" IsChecked="True" FontSize="11" Margin="0,0,16,0"/>
                    <CheckBox x:Name="ZoomInvert" Content="反转方向" FontSize="11"/>
                  </StackPanel>
                </Grid>
                <Grid Margin="0,10,0,9">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,18,0">
                    <Grid><TextBlock Text="LT · 缩小" Foreground="#607A82" FontSize="10"/><TextBlock x:Name="ZoomLeftValue" Text="0 / 255" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{DynamicResource AccentBrush}" FontSize="11"/></Grid>
                    <ProgressBar x:Name="ZoomLeftMeter" Minimum="0" Maximum="255" Value="0" Height="6" Foreground="{DynamicResource AccentBrush}" Background="#E6F0F0" BorderThickness="0" Margin="0,5,0,0"/>
                    <TextBlock x:Name="ZoomOutGainText" Text="力度灵敏度 1.0×" FontSize="11" Foreground="#607A82" Margin="0,10,0,4"/>
                    <Slider x:Name="ZoomOutGain" Minimum="0.1" Maximum="3" Value="1" TickFrequency="0.1" IsSnapToTickEnabled="True" ToolTip="只调节缩小的力度，越高越省力。"/>
                    <TextBlock x:Name="ZoomOutSpeedText" Text="缩小速度 50%" FontSize="11" Foreground="#607A82" Margin="0,8,0,4"/>
                    <Slider x:Name="ZoomOutSpeed" Minimum="5" Maximum="300" Value="50" TickFrequency="5" IsSnapToTickEnabled="True" ToolTip="超过 100% 时，本页缩小更快，虚拟扳机在较小的 Z 轴偏移时达到满值。"/>
                    <TextBlock x:Name="ZoomOutDeadZoneText" Text="回中死区 8%" FontSize="11" Foreground="#607A82" Margin="0,8,0,4"/>
                    <Slider x:Name="ZoomOutDeadZone" Minimum="0" Maximum="0.4" Value="0.08" TickFrequency="0.01" IsSnapToTickEnabled="True" ToolTip="只调节缩小方向的回中死区。"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <Grid><TextBlock Text="RT · 放大" Foreground="#607A82" FontSize="10"/><TextBlock x:Name="ZoomRightValue" Text="0 / 255" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{DynamicResource AccentBrush}" FontSize="11"/></Grid>
                    <ProgressBar x:Name="ZoomRightMeter" Minimum="0" Maximum="255" Value="0" Height="6" Foreground="{DynamicResource AccentBrush}" Background="#E6F0F0" BorderThickness="0" Margin="0,5,0,0"/>
                    <TextBlock x:Name="ZoomInGainText" Text="力度灵敏度 1.0×" FontSize="11" Foreground="#607A82" Margin="0,10,0,4"/>
                    <Slider x:Name="ZoomInGain" Minimum="0.1" Maximum="3" Value="1" TickFrequency="0.1" IsSnapToTickEnabled="True" ToolTip="只调节放大的力度，越高越省力。"/>
                    <TextBlock x:Name="ZoomInSpeedText" Text="放大速度 50%" FontSize="11" Foreground="#607A82" Margin="0,8,0,4"/>
                    <Slider x:Name="ZoomInSpeed" Minimum="5" Maximum="300" Value="50" TickFrequency="5" IsSnapToTickEnabled="True" ToolTip="超过 100% 时，本页放大更快，虚拟扳机在较小的 Z 轴偏移时达到满值。"/>
                    <TextBlock x:Name="ZoomInDeadZoneText" Text="回中死区 8%" FontSize="11" Foreground="#607A82" Margin="0,8,0,4"/>
                    <Slider x:Name="ZoomInDeadZone" Minimum="0" Maximum="0.4" Value="0.08" TickFrequency="0.01" IsSnapToTickEnabled="True" ToolTip="只调节放大方向的回中死区。"/>
                  </StackPanel>
                </Grid>
                <TextBlock x:Name="ZoomHintText" Text="Z+ 放大 · Z− 缩小。两方向的力度、速度和死区分别调节；外部软件需绑定 LT / RT 到缩放。" FontSize="10" Foreground="#71868C" TextWrapping="Wrap" Margin="0,3,0,0"/>
              </StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#DFE8EA" BorderThickness="1" CornerRadius="12" Padding="15,13" Margin="0,14,0,0">
              <StackPanel>
                <TextBlock Text="轴映射与手感" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock Text="内置设置使用平移 X / Y，推动操纵帽控制左右和上下。可在下方选择其他通道。" Foreground="#71868C" FontSize="11" Margin="0,6,0,12" TextWrapping="Wrap"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,18,0">
                    <TextBlock Text="右摇杆 X · 左右看" FontSize="11" Foreground="#607A82" Margin="0,0,0,5"/>
                    <ComboBox x:Name="StickSourceX" Height="30"/>
                    <CheckBox x:Name="StickInvertX" Content="反转 X" FontSize="11" Margin="0,8,0,0"/>
                    <TextBlock x:Name="StickGainXText" Text="X 增益 1.0" FontSize="11" Foreground="#607A82" Margin="0,11,0,5"/>
                    <Slider x:Name="StickGainX" Minimum="0.1" Maximum="3" Value="1" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="右摇杆 Y · 上下看" FontSize="11" Foreground="#607A82" Margin="0,0,0,5"/>
                    <ComboBox x:Name="StickSourceY" Height="30"/>
                    <CheckBox x:Name="StickInvertY" Content="反转 Y" IsChecked="True" FontSize="11" Margin="0,8,0,0"/>
                    <TextBlock x:Name="StickGainYText" Text="Y 增益 1.0" FontSize="11" Foreground="#607A82" Margin="0,11,0,5"/>
                    <Slider x:Name="StickGainY" Minimum="0.1" Maximum="3" Value="1" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                  </StackPanel>
                </Grid>
                <Grid Margin="0,13,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,18,0"><TextBlock x:Name="StickDeadZoneText" Text="径向死区 0.08" FontSize="11" Foreground="#607A82" Margin="0,0,0,6"/><Slider x:Name="StickDeadZone" Minimum="0" Maximum="0.4" Value="0.08" TickFrequency="0.01" IsSnapToTickEnabled="True"/></StackPanel>
                  <StackPanel Grid.Column="1" Margin="0,0,18,0"><TextBlock x:Name="StickGammaText" Text="响应曲线 1.5" FontSize="11" Foreground="#607A82" Margin="0,0,0,6"/><Slider x:Name="StickGamma" Minimum="1" Maximum="3" Value="1.5" TickFrequency="0.1" IsSnapToTickEnabled="True"/></StackPanel>
                  <StackPanel Grid.Column="2"><TextBlock Text="实体按键启停" FontSize="11" Foreground="#607A82" Margin="0,0,0,4"/><ComboBox x:Name="StickToggleKey" Height="28" FontSize="11"/></StackPanel>
                </Grid>
                <WrapPanel Margin="0,14,0,0">
                  <Button x:Name="StickCalibrateButton" Content="以当前位置为中心" Height="28" FontSize="11" Padding="10,0" Margin="0,0,8,0"/>
                  <Button x:Name="StickClearCenterButton" Content="清除校准" Height="28" FontSize="11" Padding="10,0" Margin="0,0,12,0"/>
                  <TextBlock x:Name="StickCenterText" Text="中心：未校准" Foreground="#71868C" FontSize="10" VerticalAlignment="Center"/>
                </WrapPanel>
              </StackPanel>
            </Border>
            <TextBlock Text="持续偏转持续转向或缩放；松手后停止并保留视角与倍率。150 ms 无新数据时，右摇杆和两扳机归零。虚拟手柄需由目标软件绑定相应功能。" FontSize="11" Foreground="#71868C" TextWrapping="Wrap" Margin="2,12,2,5"/>
          </StackPanel>
        </ScrollViewer>
      </Grid>
      <Grid x:Name="SettingsPage" Grid.Row="3" Visibility="Collapsed">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
          <StackPanel>
            <Border Background="White" BorderBrush="#DFE8EA" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="开机自启动" FontSize="16" FontWeight="SemiBold"/>
                <CheckBox x:Name="StartupCheckBox" Content="登录 Windows 后打开 SpaceKat 小助手" Margin="0,10,0,6"/>
                <TextBlock x:Name="StartupStatusText" FontSize="11" Foreground="#607A82" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#DFE8EA" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="主题色" FontSize="16" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <ComboBox x:Name="ThemePicker" Width="155" Height="32"/>
                  <Border Width="60" Height="32" Background="{DynamicResource AccentBrush}" CornerRadius="6" Margin="12,0,0,0"/>
                  <TextBlock x:Name="ThemeStatusText" FontSize="11" Foreground="#607A82" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#DFE8EA" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="配置文件" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="选择 SpaceKat 配置 ZIP 或一组配置 TXT 来替换。导入前会自动备份当前配置。" FontSize="11" Foreground="#607A82" Margin="0,6,0,10" TextWrapping="Wrap"/>
                <WrapPanel>
                  <Button x:Name="ImportConfigurationButton" Content="导入并替换" Style="{StaticResource PrimaryButton}" Height="32" Margin="0,0,8,0"/>
                  <Button x:Name="ExportConfigurationButton" Content="导出配置 ZIP" Height="32"/>
                </WrapPanel>
                <TextBlock x:Name="ConfigurationStatusText" FontSize="11" Foreground="#607A82" Margin="0,8,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
